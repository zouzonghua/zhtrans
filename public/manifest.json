{
  "manifest_version": 3,
  "name": "LinxTrans",
  "version": "2.2.0",
  "description": "Clean Architecture implementation of Glimpse.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
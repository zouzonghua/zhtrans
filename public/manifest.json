{
  "manifest_version": 3,
  "name": "zhTrans",
  "version": "1.0.0",
  "description": "Clean Architecture implementation of zhTrans.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "zhTrans",
    "default_popup": "/src/presentation/ui/chrome/popup.html"
  }
}